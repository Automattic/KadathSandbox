# Copy to .env and edit. All defaults are for a throwaway local sandbox.
DB_ROOT_PASSWORD=rootsandbox
DB_PASSWORD=sandbox
WP_ADMIN_USER=admin
WP_ADMIN_PASSWORD=sandbox
# Login for the mitmweb UI at http://127.0.0.1:8081
MITMWEB_PASSWORD=sandbox
# Extra mitmproxy flags, e.g. --ignore-hosts 'updates\.example\.com:443'
MITM_EXTRA_ARGS=
