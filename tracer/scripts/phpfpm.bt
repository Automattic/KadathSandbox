#!/usr/bin/env bpftrace
// Syscalls of interest from PHP-FPM workers. Filters on comm because bpftrace reports
// PIDs from the initial namespace, which differ from the ones pgrep shows in the container.

BEGIN { printf("tracing php-fpm: openat, connect, execve, unlinkat. Ctrl-C to stop.\n"); }

tracepoint:syscalls:sys_enter_openat /comm == "php-fpm"/
{
  printf("%s pid=%d openat  %s\n", strftime("%H:%M:%S", nsecs), pid, str(args->filename));
}

tracepoint:syscalls:sys_enter_connect /comm == "php-fpm"/
{
  $sa = (struct sockaddr_in *)args->uservaddr;
  if ($sa->sin_family == 2) {
    $port = (($sa->sin_port & 0xff) << 8) | ($sa->sin_port >> 8);
    printf("%s pid=%d connect %s:%d\n", strftime("%H:%M:%S", nsecs), pid, ntop(2, $sa->sin_addr.s_addr), $port);
  } else {
    printf("%s pid=%d connect family=%d fd=%d\n", strftime("%H:%M:%S", nsecs), pid, $sa->sin_family, args->fd);
  }
}

tracepoint:syscalls:sys_enter_execve /comm == "php-fpm"/
{
  printf("%s pid=%d execve  %s\n", strftime("%H:%M:%S", nsecs), pid, str(args->filename));
}

tracepoint:syscalls:sys_enter_unlinkat /comm == "php-fpm"/
{
  printf("%s pid=%d unlink  %s\n", strftime("%H:%M:%S", nsecs), pid, str(args->pathname));
}
