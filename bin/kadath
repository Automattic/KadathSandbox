#!/usr/bin/env python3
"""KadathSandbox offering engine. Usage: kadath offer <sample> [options]"""
import sys
import os

sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))

USAGE = "usage: kadath (offer <sample> [opts] | web [--port N] [--engine CMD] | pilgrimage <library-dir> [opts])"


def main(argv):
    if len(argv) >= 2 and argv[1] == "offer":
        from kadath.run import offer
        return offer(argv[2:])
    if len(argv) >= 2 and argv[1] == "pilgrimage":
        from kadath.pilgrimage import main as pilgrimage_main
        return pilgrimage_main(argv[2:])
    if len(argv) >= 2 and argv[1] == "web":
        import argparse
        from kadath import web
        ap = argparse.ArgumentParser(prog="kadath web")
        ap.add_argument("--port", type=int, default=8090)
        ap.add_argument("--engine")
        a = ap.parse_args(argv[2:])
        engine_cmd = a.engine.split() if a.engine else None
        web.serve(port=a.port, engine_cmd=engine_cmd)
        return 0
    print(USAGE, file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv))
